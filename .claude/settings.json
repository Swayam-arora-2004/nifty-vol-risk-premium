{
  "model": "claude-sonnet-5",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "low"
    },
    "claude-sonnet-5": {
      "effortLevel": "low"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_TOOL_INPUT_command\" | grep -E 'rm -rf|sudo |--force' && { >&2 echo 'Blocked: dangerous command'; exit 2; } || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m black \"$CLAUDE_TOOL_INPUT_file_path\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.venv/bin/python\" -m pytest -q || { >&2 echo 'Tests failed. Fix the errors and ensure all tests pass before stopping.'; exit 2; }"
          }
        ]
      }
    ]
  }
}